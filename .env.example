# Worker-only Notion connection. Web requests use PostgreSQL and do not need this token.
NEXT_NOTION_TOKEN=
NEXT_NOTION_PROJECT_DB_ID=
NEXT_NOTION_OWNER_CONTACT_ID=
NEXT_NOTION_SITE_COPY_DB_ID=
# Worker-only GitHub fine-grained PAT: Contents read for selected/all repositories.
# Public pages read only the prepared aggregate; never expose this as NEXT_PUBLIC_*.
GITHUB_TOKEN=
NEXT_NOTION_ENQUIRIES_DB_ID=
# A real Notion person ID; preserves enquiry mention notifications.
NOTION_ENQUIRY_MENTION_USER_ID=

# Shared website content, enquiry outbox, and knowledge DB. Required even with AI disabled.
# Generate a unique password; never commit .env.local.
KNOWLEDGE_DB_PASSWORD=
KNOWLEDGE_DATABASE_URL=postgres://homepage:YOUR_PASSWORD@127.0.0.1:55438/homepage_knowledge

# PEM CA certificate for a production Coolify DB; keep certificate verification enabled.
KNOWLEDGE_DATABASE_CA_CERT=

# Dedicated OpenRouter key; keep its provider-side spending limit enabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Both must be true to enable the assistant UI, consent, privacy section and API.
# Release settings: redeploy after changing either flag. Leave off until reviewed.
NEXT_PUBLIC_KNOWLEDGE_ASSISTANT_ENABLED=false
KNOWLEDGE_ASSISTANT_ENABLED=false
# AI rollout, budgets and quotas are managed in PostgreSQL settings (ai.*).
# Apply migration 008; ai.enabled starts false. See docs/ai-operations.md.
KNOWLEDGE_RATE_LIMIT_SECRET=

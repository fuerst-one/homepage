{
  "name": "homepage",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/web.mjs dev",
    "build": "node --env-file-if-exists=.env.local scripts/web.mjs build",
    "start": "node --env-file-if-exists=.env.local scripts/web.mjs start",
    "build:sync": "pnpm --filter @homepage/sync build && pnpm --config.ignore-scripts=true --filter @homepage/sync deploy --prod --legacy build/sync",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:notion:integration": "node --env-file=.env.local tests/run-notion-integration.mjs",
    "prettier": "prettier --check .",
    "eslint": "eslint apps packages --ext .ts,.tsx",
    "prepare": "husky install",
    "knowledge:sync": "node --env-file=.env.local --import tsx apps/sync/scripts/knowledge.ts sync",
    "knowledge:watch": "node --env-file=.env.local --import tsx apps/sync/scripts/knowledge.ts watch",
    "knowledge:status": "node --env-file=.env.local --import tsx apps/sync/scripts/knowledge.ts status",
    "knowledge:migrate": "node --env-file=.env.local --import tsx apps/sync/scripts/knowledge.ts migrate",
    "notion:sync": "node --env-file=.env.local --import tsx apps/sync/scripts/notion.ts sync",
    "notion:watch": "node --env-file=.env.local --import tsx apps/sync/scripts/notion.ts watch",
    "notion:status": "node --env-file=.env.local --import tsx apps/sync/scripts/notion.ts status",
    "notion:migrate": "node --env-file=.env.local --import tsx apps/sync/scripts/notion.ts migrate",
    "knowledge:db": "docker compose --env-file .env.local -f compose.ai.yaml up -d --wait",
    "malt:import": "node --env-file=.env.local --import tsx apps/sync/scripts/import-malt-observation.mjs",
    "malt:refresh": "node --env-file=.env.local --import tsx apps/sync/scripts/malt.ts refresh",
    "malt:status": "node --env-file=.env.local --import tsx apps/sync/scripts/malt.ts status"
  },
  "devDependencies": {
    "@types/color": "^3.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.4",
    "eslint-config-prettier": "^9.1.2",
    "postcss": "^8.5.13",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "puppeteer": "^22.15.0",
    "tsx": "^4.23.15",
    "@homepage/content": "workspace:*",
    "@homepage/database": "workspace:*",
    "@homepage/knowledge": "workspace:*"
  }
}
